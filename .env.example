# Mail configuration
# Exemple avec Gmail (nécessite une App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=noreply@delven.fr
MAIL_TO=contact@delven.fr

# Alternative : Brevo (ex-Sendinblue)
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=your-brevo-email@example.com
# MAIL_PASS=your-brevo-api-key

# Alternative : Mailersend
# MAIL_HOST=smtp.mailersend.net
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=MS_USERNAME
# MAIL_PASS=MS_PASSWORD
