{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*.js"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "env": {
    "MAIL_HOST": "@mail_host",
    "MAIL_PORT": "@mail_port",
    "MAIL_SECURE": "@mail_secure",
    "MAIL_USER": "@mail_user",
    "MAIL_PASS": "@mail_pass",
    "MAIL_FROM": "@mail_from",
    "MAIL_TO": "@mail_to"
  }
}
